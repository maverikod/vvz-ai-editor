#!/bin/bash
# Argument surface for the ai-editor service settings in /etc/default/ai-editor.
#
# Author: Vasiliy Zdanovskiy
# email: vasilyvz@gmail.com
set -e

CLI="/usr/lib/ai-editor/ai_editor_config.py"

if [ ! -f "$CLI" ]; then
  echo "[ai-editor-config] missing $CLI (reinstall ai-editor-docker)" >&2
  exit 1
fi

case "${1:-}" in
  set|apply)
    if [ "$(id -u)" -ne 0 ]; then
      echo "[ai-editor-config] run as root: sudo ai-editor-config $*" >&2
      exit 3
    fi
    ;;
esac

exec python3 "$CLI" "$@"
